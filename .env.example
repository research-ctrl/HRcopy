# Application
NEXT_PUBLIC_APP_NAME=HR Legal Assistant
APP_ENV=production
DEFAULT_LOCALE=pt-PT
DEFAULT_JURISDICTION=PT
MOCK_MODE=false

# Local data (not used in Vercel, but kept for backwards compatibility)
LOCAL_DATA_ROOT=data

# LLM & Embedding Providers
LLM_PROVIDER_ORDER=mistral,nvidia,compatible,local
EMBEDDING_PROVIDER_ORDER=nvidia,mistral,compatible,local

# NVIDIA NIM (Optional)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Mistral AI (Optional)
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1/
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# OpenAI-Compatible API (Optional)
COMPATIBLE_API_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_CHAT_MODEL=gpt-4o-mini
COMPATIBLE_EMBEDDING_MODEL=text-embedding-3-small

# Supabase (Required for production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
